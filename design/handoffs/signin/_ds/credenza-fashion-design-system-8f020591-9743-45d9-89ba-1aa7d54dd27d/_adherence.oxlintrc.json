{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/navigation/**",
              "components/shelf/**",
              "ui_kits/fashion_app/**",
              "ui_kits/marketing_site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Clash Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Clash Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|size|gap|className|style|key|ref|className|style|children)$/]",
        "message": "<BrandLockup> doesn't accept that prop. Declared props: kicker, size, gap, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|title|className|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: size, title, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|onClick|disabled|loading|title|type|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, onClick, disabled, loading, title, type, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|subtle)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'subtle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuyButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|agent|onClick|disabled|className|style|key|ref|className|style|children)$/]",
        "message": "<BuyButton> doesn't accept that prop. Declared props: label, agent, onClick, disabled, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<Caption> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|disabled|role|className|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, active, onClick, disabled, role, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:radio|button)$/]",
        "message": "<Chip> role must be one of 'radio' | 'button'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|rows|id|disabled|className|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, value, onChange, placeholder, rows, id, disabled, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HaulBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|items|parcel|total|className|style|key|ref|className|style|children)$/]",
        "message": "<HaulBar> doesn't accept that prop. Declared props: name, items, parcel, total, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|onClick|active|size|disabled|className|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, onClick, active, size, disabled, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tracking|tone|as|className|style|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: children, size, tracking, tone, as, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|ink|money)$/]",
        "message": "<Kicker> tone must be one of 'muted' | 'ink' | 'money'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MastheadLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<MastheadLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModalShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|subtitle|onClose|footer|children|width|sheet|className|style|key|ref|className|style|children)$/]",
        "message": "<ModalShell> doesn't accept that prop. Declared props: open, title, subtitle, onClose, footer, children, width, sheet, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|className|style|key|ref|className|style|children)$/]",
        "message": "<PriceChip> doesn't accept that prop. Declared props: children, variant, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceChip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:overlay|meta|hero)$/]",
        "message": "<PriceChip> variant must be one of 'overlay' | 'meta' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|image|alt|status|favorite|onToggleFavorite|albumCount|sizeLabel|sizeKind|sizeLive|seller|buyAgent|onBuy|onOpen|selected|className|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: title, price, image, alt, status, favorite, onToggleFavorite, albumCount, sizeLabel, sizeKind, sizeLive, seller, buyAgent, onBuy, onOpen, selected, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|variant|onClear|leading|trailing|className|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, variant, onClear, leading, trailing, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bar|hero)$/]",
        "message": "<SearchField> variant must be one of 'bar' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeChartTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|recommended|footnote|className|style|key|ref|className|style|children)$/]",
        "message": "<SizeChartTable> doesn't accept that prop. Declared props: columns, rows, recommended, footnote, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeRecommendation'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|confidence|prescription|you|garment|ease|children|className|style|key|ref|className|style|children)$/]",
        "message": "<SizeRecommendation> doesn't accept that prop. Declared props: size, confidence, prescription, you, garment, ease, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|variant|dense|className|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, variant, dense, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pill|chip)$/]",
        "message": "<StatusPill> variant must be one of 'pill' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:stops|current|onChange|nextLabel|onNext|detour|className|style|key|ref|className|style|children)$/]",
        "message": "<StatusTrack> doesn't accept that prop. Declared props: stops, current, onChange, nextLabel, onNext, detour, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|action|onAction|className|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, tone, icon, action, onAction, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|error)$/]",
        "message": "<Toast> tone must be one of 'default' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ViewTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|count|key|ref|className|style|children)$/]",
        "message": "<ViewTab> doesn't accept that prop. Declared props: value, label, count."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
