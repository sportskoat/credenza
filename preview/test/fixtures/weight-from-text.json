    {
      "id": "no-weight",
      "text": "Size M fits me at 180cm 75kg",
      "expect": null,
      "note": "Body weight must not become item weight — 75kg is body, not package"
    },
    {
      "id": "empty",
      "text": "",
      "expect": null
    },
    {
      "id": "tiny-g-reject",
      "text": "1g sample",
      "expect": null
    }
  ]
