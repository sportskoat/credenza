{
  "version": 2,
  "note": "Golden cases for itemWeightGrams / haulWeightGrams / volumetric / chargeable. CATEGORY_WEIGHT_GRAMS mids come from weight-estimate WEIGHT_BANDS via CATEGORY_TO_WEIGHT_KEY (2026-07-25 product wire).",
  "categoryDefaultsGrams": {
    "shirt": 200,
    "pants": 700,
    "shorts": 300,
    "shoes": 900,
    "outerwear": 500,
    "accessory": 200,
    "socks": 80,
    "bag": 900,
    "hat": 120,
    "other": 300
  },
  "itemWeightGrams": [
    {
      "id": "override-wins",
      "item": { "category": "shirt", "weightGrams": 420 },
      "expect": 420
    },
    {
      "id": "override-wins-over-shoes-default",
      "item": { "category": "shoes", "weightGrams": 400 },
      "expect": 400
    },
    {
      "id": "category-shirt",
      "item": { "category": "shirt" },
      "expect": 200
    },
    {
      "id": "category-shoes",
      "item": { "category": "shoes" },
      "expect": 900
    },
    {
      "id": "garbage-zero-falls-back",
      "item": { "category": "pants", "weightGrams": 0 },
      "expect": 700
    },
    {
      "id": "garbage-negative-falls-back",
      "item": { "category": "pants", "weightGrams": -50 },
      "expect": 700
    },
    {
      "id": "garbage-string-falls-back",
      "item": { "category": "pants", "weightGrams": "abc" },
      "expect": 700
    },
    {
      "id": "unknown-category-null",
      "item": { "category": "not-a-category" },
      "expect": null
    },
    {
      "id": "empty-item-null",
      "item": {},
      "expect": null
    },
    {
      "id": "rounds-fractional-override",
      "item": { "weightGrams": 123.7 },
      "expect": 124
    },
    {
      "id": "title-hoodie-beats-shirt-category",
      "item": { "category": "shirt", "title": "Heavyweight hoodie batch" },
      "expect": 850
    },
    {
      "id": "listing-text-grams",
      "item": { "category": "shirt", "note": "Ship weight 380g after QC" },
      "expect": 380
    }
  ],
  "haulWeightGrams": [
    {
      "id": "sum-two",
      "items": [
        { "category": "shirt" },
        { "category": "shoes", "weightGrams": 800 }
      ],
      "expect": 1000
    },
    {
      "id": "skip-returned",
      "items": [
        { "category": "shirt", "weightGrams": 300 },
        { "category": "shoes", "weightGrams": 800, "findStatus": "returned" }
      ],
      "expect": 300
    },
    {
      "id": "all-returned-null",
      "items": [{ "category": "shirt", "findStatus": "returned" }],
      "expect": null
    },
    {
      "id": "empty-list-null",
      "items": [],
      "expect": null
    }
  ],
  "volumetricWeightGrams": [
    {
      "id": "40x30x20",
      "dims": { "l": 40, "w": 30, "h": 20 },
      "expect": 4800
    },
    {
      "id": "missing-h-null",
      "dims": { "l": 40, "w": 30 },
      "expect": null
    },
    {
      "id": "zero-h-null",
      "dims": { "l": 40, "w": 30, "h": 0 },
      "expect": null
    }
  ],
  "chargeableWeightGrams": [
    {
      "id": "volumetric-wins",
      "args": { "actualGrams": 2000, "dims": { "l": 40, "w": 30, "h": 20 }, "packaging": "none" },
      "expect": 4800
    },
    {
      "id": "actual-wins",
      "args": { "actualGrams": 6000, "dims": { "l": 40, "w": 30, "h": 20 }, "packaging": "none" },
      "expect": 6000
    },
    {
      "id": "packaging-standard-on-actual",
      "args": { "actualGrams": 5000, "dims": { "l": 40, "w": 30, "h": 20 }, "packaging": "standard" },
      "expect": 5500
    },
    {
      "id": "actual-only",
      "args": { "actualGrams": 1500, "packaging": "none" },
      "expect": 1500
    },
    {
      "id": "dims-only",
      "args": { "dims": { "l": 40, "w": 30, "h": 20 } },
      "expect": 4800
    },
    {
      "id": "empty-null",
      "args": {},
      "expect": null
    }
  ]
}
