# Copy this file to .env and fill in the values. Never commit .env.
#
# WARNING: put ONLY publishable values here. VITE_ vars are compiled into the
# browser bundle, so anyone can read them. Service-role and Stripe secret keys
# belong in the Netlify function environment, never in a VITE_ var.
#
# `npm run build` runs scripts/preflight-env.js first. That script reads THIS
# file to learn which keys the build needs. A key below is REQUIRED unless the
# line directly above it says `# optional`. Add a key here and the next build
# starts checking it.

# --- Required ---------------------------------------------------------------

# Search proxy shared secret. The app signs its own function calls with it.
VITE_CREDENZA_SEARCH_SECRET=

# Supabase, for sign-in. Both values are on Netlify already (project
# uaweaziqrybvxfbacllb). Copy them with:
#   netlify env:get VITE_SUPABASE_URL
#   netlify env:get VITE_SUPABASE_ANON_KEY
#
# AUTH_ENABLED in preview/src/auth.js is `!!(URL && ANON_KEY)`. With either
# value missing, the whole account section disappears from the Profile sheet.
# That is why sign-in looks deleted in a local build — it is not deleted, the
# build has no Supabase to sign in to. Production shipped that way once. The
# preflight check exists so it cannot happen again.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional ---------------------------------------------------------------
#
# Agent affiliate codes. `agents.js` reads each one by name and falls back to a
# plain marketplace link when it is absent, so a missing code costs revenue and
# breaks nothing. Add the ones you hold.
# optional
VITE_CREDENZA_REF_SUPERBUY=
# optional
VITE_CREDENZA_REF_SUGARGOO=
# optional
VITE_CREDENZA_REF_CSSBUY=
# optional
VITE_CREDENZA_REF_KAKOBUY=
# optional
VITE_CREDENZA_REF_FANSBUY=
# optional
VITE_CREDENZA_REF_MULEBUY=
# optional
VITE_CREDENZA_REF_JOYAGOO=
# optional
VITE_CREDENZA_REF_HOOBUY=
# optional
VITE_CREDENZA_REF_OOPBUY=
# optional
VITE_CREDENZA_REF_ALLCHINABUY=

# Cloud sync (LB-7). Off unless this reads exactly "true".
#
# Turn it on ONLY after running docs/sql/2026-07-26-shelves.sql in Supabase.
# Without that table every sync call answers 404, and while the app degrades
# quietly, nothing syncs — so the flag would be a lie.
#
# What it turns on: pull-on-sign-in for every account (the restore story, free)
# and continuous push for Pro accounts.
# optional
VITE_ENABLE_SYNC=

# Function endpoint overrides. Every one of these has a working
# `/.netlify/functions/<name>` default in the source, so set one only to point
# a build at a different deploy.
# optional
VITE_ASK_ENDPOINT=
# optional
VITE_CHART_VISION_ENDPOINT=
# optional
VITE_CHECKOUT_ENDPOINT=
# optional
VITE_DELETE_ACCOUNT_ENDPOINT=
# optional
VITE_ENTITLEMENT_ENDPOINT=
# optional
VITE_PORTAL_ENDPOINT=
# optional
VITE_PREVIEW_ENDPOINT=
# optional
VITE_REDDIT_ENDPOINT=
# optional
VITE_RESOLVE_ENDPOINT=
# optional
VITE_YUPOO_ENDPOINT=
# optional
VITE_ENABLE_CLOUD_ASK=

# --- Not in this file, on purpose -------------------------------------------
#
# These live in the Netlify function environment only. They are secret. A VITE_
# copy of any of them would be readable by every visitor.
#
# They are comments on purpose. preflight-env.js reads a real key on a line of
# its own as REQUIRED, and the build would then refuse to run on a laptop that
# by design has no server secrets. Leave them commented.
#
# A local run therefore has no server variables at all. Shared links fail on a
# laptop for that reason, and that is expected. Kyle 2026-08-02.
#
#   SUPABASE_URL                the functions' own copy, unprefixed
#   SUPABASE_SERVICE_ROLE_KEY   the functions' admin key
#   STRIPE_SECRET_KEY           checkout and portal
#   STRIPE_WEBHOOK_SECRET       webhook signature check
#   STRIPE_PRICE_MONTHLY        the $4.99 Price id
#   STRIPE_PRICE_YEARLY         the $39.99 Price id
#   CREDENZA_SEARCH_SECRET      the server half of the shared secret
#   CREDENZA_ENTITLEMENT_SECRET signs the entitlement snapshots
#   ANTHROPIC_API_KEY           Ask and the size-chart reader
#   REQUIRE_ACCOUNTS            set true only after the LB-5 checkout test
#   CREDENZA_OWNER_EMAILS       comma-separated creator emails with permanent access
#   CREDENZA_OWNER_USER_IDS     optional comma-separated account ids for owner access
#
# Read them with `netlify env:list`. Never paste one into a chat window.
