{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": false,
    "types": ["node"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "exclude": ["node_modules"],
  "include": [
    "types/**/*.d.ts",
    "../credenza-storage.js",
    "../credenza-search.js",
    "netlify/functions/**/*.js"
  ]
}
